---

# Generic
generic:
  role: ansible-role-rspamd
  role_short: rspamd
  role_description: |
    Installs & manages rspamd 

# Supported platforms
platforms:
  rhel9:
    supported: false
    ci: false
  rhel10:
    supported: false
    ci: false
  rockylinux9:
    supported: false
    ci: false
  rockylinux10:
    supported: false
    ci: false
  oraclelinux9:
    supported: false
    ci: false
  oraclelinux10:
    supported: false
    ci: false
  almalinux9:
    supported: false
    ci: false
  almalinux10:
    supported: false
    ci: false
  debian13:
    supported: false
    ci: false
  fedora42:
    supported: false
    ci: false
  fedora43:
    supported: false
    ci: false

molecule:
  converge:
    roles:
      - deitkrachten.cron
      - deitkrachten.openssl
      - deitkrachten.postfix
    vars:
      rspamd_organization: 'Example Inc'
      rspamd_controller_password: '$2$hrr3pjpiie499r1e7tb1p4qxm84mqeo9$rkgidupktocmsiog5wnm6z93ui9t8jrqpw8ta4sq8dty6djo5bdb'
      rspamd_domains:
        - example.com
        - foo.bar
      dovecot_ssl_key: "{{ openssl_server_key }}"
      dovecot_ssl_chain: "{{ openssl_server_crt }}"
      dovecot_domain: example.com
      postfix_ipv6: false
      postfix_domain: example.com
      postfix_fqdn: host.example.com
      postfix_ssl_key: "{{ openssl_server_key }}"
      postfix_ssl_chain: "{{ openssl_server_crt }}"
  requirements:
    roles_extra:
      - deitkrachten.cron
      - deitkrachten.openssl
      - deitkrachten.postfix
